# Copy to .env and fill in only the engines you want to run. .env is git-ignored.

MISTRAL_API_KEY=          # https://console.mistral.ai
OPENROUTER_API_KEY=       # https://openrouter.ai/keys  (for the 3 Gemini scripts)
VISION_AGENT_API_KEY=     # https://va.landing.ai       (LandingAI ADE)

# Optional
# GEMINI_PROVIDERS=google-vertex,google-ai-studio   # Google AI Studio may stop with RECITATION on these pages
# PADDLE_VL_BACKEND=vllm-server                     # serve the PaddleOCR-VL model separately (or mlx-vlm-server)
# PADDLE_VL_SERVER_URL=http://localhost:8111/
# TESSDATA_DIR=/path/to/tessdata_fast               # the published run used tessdata_fast eng + fra
